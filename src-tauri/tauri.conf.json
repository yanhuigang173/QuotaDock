{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaDock",
  "version": "0.3.0",
  "identifier": "cn.codex.quota.widget",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "url": "renderer/index.html",
      "title": "QuotaDock",
      "width": 230,
      "height": 40,
      "minWidth": 1,
      "minHeight": 1,
      "decorations": false,
      "transparent": true,
      "shadow": false,
      "resizable": false,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "visible": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../assets/quotadock.ico"]
  }
}
